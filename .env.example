TELEGRAM_BOT_TOKEN=123456:replace-me
ALLOWED_TELEGRAM_USER_IDS=123456789

# Host user/group values exposed to the container for NAS deployments.
# On Linux/NAS hosts, run: id
PUID=1000
PGID=10

# Host paths mounted by Docker Compose.
MUSIC_DIR_HOST=./music
DOWNLOAD_TMP_DIR_HOST=./tmp/sync-me-maybe

# Optional. Put a Netscape-format cookies file here and set
# YTDLP_COOKIES_FILE=/config/cookies.txt to pass it to yt-dlp.
YTDLP_COOKIES_FILE_HOST=./cookies.txt
YTDLP_COOKIES_FILE=

MAX_DOWNLOAD_SECONDS=900
MAX_COLLECTION_TRACKS=1000
UPLOAD_BATCH_WINDOW_SECONDS=2
# Output format for link downloads: m4a (default), opus, or mp3.
AUDIO_FORMAT=m4a
# YouTube Music matching, Deezer metadata, and cover art lookups.
METADATA_LOOKUP=true
RECEIVED_STICKER_ID=
LOG_LEVEL=INFO
